# GitLab 서버 접속 정보
GITLAB_HOSTNAME=192.168.x.x
GITLAB_HTTP_PORT=8929
GITLAB_HTTPS_PORT=8443
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=

# HTTPS 설정
# 로컬/http 테스트 시: GITLAB_EXTERNAL_URL=http://192.168.x.x, GITLAB_REDIRECT_HTTP_TO_HTTPS=false
# 사설 인증서 적용 시: GITLAB_EXTERNAL_URL=https://192.168.x.x, GITLAB_REDIRECT_HTTP_TO_HTTPS=true
GITLAB_EXTERNAL_URL=http://192.168.x.x
GITLAB_REDIRECT_HTTP_TO_HTTPS=false
# 인증서(.crt/.key)가 있는 호스트 디렉토리. 미설정 시 기본값 ./ssl 사용
# GITLAB_SSL_DIR=/opt/gitlab/ssl

# 이메일 설정 (선택사항)
# GITLAB_SMTP_HOST=smtp.example.com
# GITLAB_SMTP_USER=user@example.com
# GITLAB_SMTP_PASSWORD=
# GITLAB_SMTP_DOMAIN=example.com
